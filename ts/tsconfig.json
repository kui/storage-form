{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["chrome"],
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "../js",
    "declarationDir": "../types"
  }
}
