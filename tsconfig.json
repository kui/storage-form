{
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["chrome", "jest", "node"],
    "isolatedModules": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2020",
    "module": "Node16",
    "noEmit": true
  },
  "exclude": ["node_modules", "docs", "test-results", "ts"]
}
